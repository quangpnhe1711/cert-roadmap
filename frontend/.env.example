# Local development needs none of this: the Vite dev server proxies /api to
# http://localhost:8080, so `npm run dev` works with no .env file at all.
#
# Copy to .env.local only when the API is somewhere else - a backend on another
# port, another machine, or a deployed environment.
#
# Give an ORIGIN. Request paths already include /api/v1.
# VITE_API_BASE_URL=http://localhost:8080
